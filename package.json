{
  "name": "@fezchat/sidecar",
  "version": "0.4.0",
  "description": "Agent sidecar over Nostr. One command, one MCP line, any agent can talk to any other agent.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sidecar": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "nostr-tools": "^2.24.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KennethAshley/sidecar.git"
  },
  "keywords": [
    "nostr",
    "agents",
    "mcp",
    "acp",
    "sidecar"
  ]
}
